# 数据库配置
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USERNAME=root
DATABASE_PASSWORD=OptimusRoot2024Secure
DATABASE_NAME=optimus
DB_CHARSET=utf8mb4
DB_SYNCHRONIZE=false

# JWT 配置（管理员）
JWT_SECRET=your-admin-jwt-secret-key
JWT_EXPIRES_IN=5h
JWT_REFRESH_EXPIRES_IN=7d

# 客户端用户 JWT 配置
CLIENT_USER_JWT_SECRET=your-client-jwt-secret-key
CLIENT_USER_JWT_EXPIRES_IN=2h
CLIENT_USER_REFRESH_EXPIRES_IN=7d

# 服务身份 JWT 的【主密钥】。只放环境变量，不写入仓库/数据库。
#
# 它本身不直接签任何 token：每个服务用 HKDF(主密钥, serviceKey) 派生出的专属密钥签名。
# 因此这个值只有平台需要持有——【绝不能下发给子服务，尤其不能给外包】。持有主密钥
# 等于能签发任意服务的身份；子服务只需要拿到自己那一份派生密钥（带外分发）。
SERVICE_TOKEN_SECRET=replace-with-a-long-random-service-secret
SERVICE_TOKEN_EXPIRES_IN=5m

# 加密配置
# 密码传输 AES 密钥——必须与前端一致（前端读 NEXT_PUBLIC_CRYPTO_SECRET，
# 不配则落 @optimus/common 的默认值），两端不同则密文永远解不开、
# 加密注册/登录全灭。生产环境两端配同一个自定义值。
CRYPTO_SECRET=optimus-client-crypto-key-2024

# Cookie 配置
# COOKIE_DOMAIN 留空=host-only cookie(本地开发必须留空,配了域名 localhost 会拒收);
# 只有生产要跨子域共享登录态时才配,形如 .example.com
# COOKIE_DOMAIN=

# 其他配置
NODE_ENV=development
APP_PORT=8084

# 客户端用户签名密钥（旧版本兼容，可以移除）
CLIENT_USER_SIGN_KEY=your-client-user-sign-key

# GameWemade 配置
GAMEWEMADE_SDK_OPEN_KEY=your-gamewemade-open-key
GAMEWEMADE_SDK_CALLBACK_KEY=your-gamewemade-callback-key
