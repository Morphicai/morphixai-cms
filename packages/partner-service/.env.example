# 数据库配置——与 optimus-api 指向同一个 MySQL 实例(dev 阶段不拆库)
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USERNAME=root
DATABASE_PASSWORD=OptimusRoot2024Secure
DATABASE_NAME=optimus

# 服务自身
APP_PORT=8089

# 主服务地址,IntrospectAuthGuard 拿 token 去这里换身份
OPTIMUS_API_URL=http://localhost:8084/api

# 本服务【自己的】服务身份签名密钥（不是平台主密钥），只经环境变量注入。
# 由平台用 HKDF(主密钥, "partner-service") 派生后下发，生成方式见
# docs/THIRD_PARTY_ONBOARDING.md §三。用它只能签发 sub=partner-service 的 token，
# 冒充不了别的服务；反过来也反推不出平台主密钥。
SERVICE_TOKEN_SECRET=replace-with-the-derived-secret-for-partner-service
SERVICE_TOKEN_EXPIRES_IN=5m
