# 数据库配置——与 optimus-api 指向同一个 MySQL 实例(dev 阶段不拆库)
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USERNAME=root
DATABASE_PASSWORD=OptimusRoot2024Secure
DATABASE_NAME=optimus

# 服务自身
APP_PORT=8089

# 主服务地址,IntrospectAuthGuard 拿 token 去这里换身份
OPTIMUS_API_URL=http://localhost:8084/api

# 与 optimus-api 共享的服务身份 JWT 密钥，只经环境变量注入
SERVICE_TOKEN_SECRET=replace-with-a-long-random-service-secret
SERVICE_TOKEN_EXPIRES_IN=5m
